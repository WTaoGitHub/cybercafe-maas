{
  "ingresses": [
    {
      "name": "ai-route-route-1.internal",
      "namespace": "higress-system",
      "policies": {
        "higress.io/destination": "50% model-1-14.static:80\n50% model-1-15.static:80",
        "higress.io/proxy-next-upstream": "error,timeout,http_503,http_502,non_idempotent",
        "higress.io/proxy-next-upstream-tries": "2",
        "higress.io/rewrite-target": "/$1$3"
      },
      "paths": [
        "/(v1)(-openai)?(/chat/completions)",
        "/(v1)(-openai)?(/completions)",
        "/(v1)(-openai)?(/responses)",
        "/(v1)(-openai)?(/embeddings)",
        "/(v1)(-openai)?(/audio/transcriptions)",
        "/(v1)(-openai)?(/audio/speech)",
        "/(v1)(-openai)?(/images/generations)",
        "/(v1)(-openai)?(/images/edits)",
        "/(v1)()(/audio/translations)",
        "/(v1)()(/images/variations)",
        "/(v1)()(/moderations)",
        "/(v1)()(/score)",
        "/(v1)()(/rerank)",
        "/(v2)()(/rerank)",
        "/(v1)()(/messages)",
        "/(v1)()(/messages/count_tokens)",
        "/(v1)()(/complete)"
      ]
    },
    {
      "name": "gpustack",
      "namespace": "higress-system",
      "policies": {
        "higress.io/destination": "gpustack.static:80"
      },
      "paths": [
        "/"
      ]
    }
  ],
  "plugins": [
    {
      "name": "gpustack-ai-proxy",
      "phase": null,
      "priority": 100
    },
    {
      "name": "gpustack-ai-statistics",
      "phase": null,
      "priority": 900
    },
    {
      "name": "gpustack-header-transformer",
      "phase": "AUTHN",
      "priority": 810
    },
    {
      "name": "gpustack-llm-ext-auth",
      "phase": "AUTHN",
      "priority": 360
    },
    {
      "name": "gpustack-model-mapper",
      "phase": "AUTHN",
      "priority": 800
    },
    {
      "name": "gpustack-model-router",
      "phase": "AUTHN",
      "priority": 900
    },
    {
      "name": "gpustack-set-model-pre-route",
      "phase": "AUTHN",
      "priority": 90
    },
    {
      "name": "gpustack-token-usage",
      "phase": null,
      "priority": 400
    }
  ]
}
