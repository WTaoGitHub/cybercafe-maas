[Unit]
Description=Wait for clone readiness and join GPUStack after basic system startup
After=multi-user.target network-online.target docker.service swcfghostname.service

[Service]
Type=oneshot
ExecStart=/opt/maas/bin/maas-worker-bootstrap boot
RemainAfterExit=yes
TimeoutStartSec=620
UMask=0077
StandardOutput=journal
StandardError=journal
