[Unit]
Description=Join GPUStack when clone prerequisites are ready
After=network-online.target docker.service swcfghostname.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/opt/maas/bin/maas-worker-bootstrap boot
RemainAfterExit=yes
TimeoutStartSec=620
Restart=on-failure
RestartPreventExitStatus=1 2
RestartSec=2min
UMask=0077
StandardOutput=journal
StandardError=journal
