[Unit]
Description=Clone inference boundary before worker registration
After=multi-user.target network-online.target docker.service swcfghostname.service

[Service]
Type=oneshot
TimeoutStartSec=45s
TimeoutStopSec=10s
ExecStart=/usr/bin/python3 /opt/maas/ops/clone_boundary.py apply
RemainAfterExit=yes
