[Unit]
Description=Clone inference boundary before worker registration
After=network-online.target docker.service

[Service]
Type=oneshot
TimeoutStartSec=45s
TimeoutStopSec=10s
ExecStart=/usr/bin/python3 /opt/maas/ops/clone_boundary.py apply
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
