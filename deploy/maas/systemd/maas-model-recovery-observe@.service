[Unit]
Description=Sample signed execution settlement for MaaS model %i
After=docker.service

[Service]
Type=oneshot
StandardInput=file:/usr/local/libexec/maas/observe_pp_settlement.py
StandardOutput=journal
ExecStart=/usr/bin/docker exec -i maas-control-api-1 python -B - %i
TimeoutStartSec=30s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
