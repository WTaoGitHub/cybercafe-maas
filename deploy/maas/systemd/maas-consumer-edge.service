[Unit]
Description=MaaS consumer HTTP on the dedicated Docker network
Requires=docker.service maas-consumer-api.socket
After=docker.service maas-consumer-api.socket
PartOf=docker.service

[Service]
EnvironmentFile=/srv/cybercafe-maas/control/consumer-edge/image.env
ExecStart=/usr/bin/docker run --rm --pull=never --name maas-consumer-edge \
    --network maas-consumer --network-alias maas-edge \
    --user 101:101 --read-only --cap-drop ALL --security-opt no-new-privileges \
    --tmpfs /tmp:rw,nosuid,nodev,size=32m \
    --mount type=bind,src=/srv/cybercafe-maas/control/consumer-edge/nginx.conf,dst=/etc/nginx/maas.conf,readonly \
    --mount type=bind,src=/run/maas-consumer,dst=/run/maas-consumer,readonly \
    --entrypoint nginx ${MAAS_CONSUMER_EDGE_IMAGE} -c /etc/nginx/maas.conf -g "daemon off;"
ExecStop=-/usr/bin/docker stop --time 10 maas-consumer-edge
Restart=always
RestartSec=3s
TimeoutStopSec=20s

[Install]
WantedBy=multi-user.target
