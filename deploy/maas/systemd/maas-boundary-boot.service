[Unit]
Description=MaaS pre-DNAT boot fence before Docker and networking
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target docker.service docker.socket
PartOf=docker.service
[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /root/wtaobj/maas-framework/scripts/maas/runtime/persist_boundary.py boot
RemainAfterExit=yes
[Install]
WantedBy=multi-user.target
