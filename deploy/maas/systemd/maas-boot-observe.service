[Unit]
Description=Observe confirmed GPU boot handoffs and unresolved execution candidates
After=docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/maas/boot-observe.env
ExecStart=/usr/bin/python3 -B /usr/local/libexec/maas/observe_boot_sessions.py --cluster ${MAAS_BOOT_OBSERVE_CLUSTER} --approval-root ${MAAS_BOOT_APPROVAL_ROOT}
TimeoutStartSec=25s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
