# Future external ingress. TLS certificate and network policy are deployment
# prerequisites; this template does not close existing GPUStack/worker ports.
# GPUStack UI/Playground must remain on an operator-only network/SSH tunnel.
server {
    listen 127.0.0.1:18831;
    server_name _;
    client_max_body_size 20m;
    location = /maas/internal/worker-shutdown-events {
        if ($args != "") { return 400; }
        limit_except POST { deny all; }
        client_max_body_size 4k;
        proxy_pass http://127.0.0.1:18830;
        proxy_next_upstream off;
        proxy_connect_timeout 1s;
        proxy_read_timeout 1s;
        proxy_set_header Authorization $http_authorization;
    }
    location /maas/v1/ {
        proxy_pass http://127.0.0.1:18830;
        proxy_read_timeout 125s;
        proxy_set_header Authorization $http_authorization;
    }
    location = /gpustack/v1/chat/completions {
        proxy_pass http://127.0.0.1:18830;
        proxy_read_timeout 125s;
        proxy_next_upstream off;
        proxy_set_header Authorization $http_authorization;
    }
    location / { return 404; }
}
