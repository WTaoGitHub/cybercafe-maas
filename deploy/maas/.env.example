# Save the real file privately; generate a URL-safe random hex database password.
MAAS_DB_PASSWORD=replace_with_random_hex_password
MAAS_GPUSTACK_URL=http://127.0.0.1:18080
MAAS_SECRET_DIR=/absolute/private/maas-secrets
MAAS_CATALOG_PATH=/absolute/private/maas-live/catalog.json
MAAS_PROBE_DIR=/absolute/non-secret/probes
# Set this to the explicit tag built from the approved source commit.
MAAS_TASK_IMAGE=cybercafe-maas-tasks:replace_with_release_tag
